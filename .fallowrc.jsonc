{
  // JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    // Package entry points come from package.json `exports`. The dev app lives in
    // dev/, not the root, so Next.js auto-detection misses its route files.
    "dev/app/**/{page,layout,route,not-found}.{ts,tsx}"
  ],
  "ignorePatterns": [
    // Generated by Payload (`pnpm generate:importmap`, `pnpm generate:types`).
    "dev/app/(payload)/admin/importMap.js",
    "dev/payload-types.ts"
  ],
  // shadcn-style primitives export their whole surface (sub-parts, variants) on
  // purpose; the studio uses a subset.
  "ignoreExports": [{ "file": "src/client/ui/**", "exports": ["*"] }],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Loaded by the `payload` CLI (node_modules/payload/bin.js) to read payload.config.ts.
    "@swc-node/register",
    // Referenced by name in dev/postcss.config.mjs.
    "@tailwindcss/postcss"
  ],
  "duplicates": {
    // Hide pair-only clones; lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    // dev/ is the development app, not shipped code; what it imports stays a devDependency.
    "dev-dependencies-in-production": "off",
    // Not configured for this project; stating it so the report does not list them as unmeasured.
    "boundary-violation": "off",
    "policy-violation": "off"
  }
}
